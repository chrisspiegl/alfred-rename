{
  "name": "alfred-transform",
  "version": "0.0.1",
  "description": "Alfred workflow to transform CSV files between comma, semicolon, and tab delimiters.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "repository": "chrisspiegl/alfred-transform",
  "author": {
    "name": "Chris Spiegl",
    "email": "chris@chrisspiegl.com",
    "url": "https://chrisspiegl.com/"
  },
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "postinstall": "alfy-init",
    "preuninstall": "alfy-cleanup",
    "cu": "ncu",
    "cu:fix": "ncu -u",
    "test": "xo --fix"
  },
  "files": [
    "icon.png",
    "info.plist",
    "index.js",
    "src"
  ],
  "keywords": [
    "alfred",
    "workflow",
    "macos",
    "mac",
    "csv",
    "tsv",
    "delimiter",
    "transform",
    "comma",
    "semicolon",
    "tab",
    "separator"
  ],
  "dependencies": {
    "alfy": "^0.12.2",
    "fast-csv": "^5.0.5"
  },
  "devDependencies": {
    "npm-check-updates": "^12.0.5",
    "xo": "^0.47.0"
  }
}
